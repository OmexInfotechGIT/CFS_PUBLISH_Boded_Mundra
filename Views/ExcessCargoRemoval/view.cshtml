@model CFS.Models.ExcessCargoRemoval
@{
    ViewBag.Title = "View Excess Cargo Removal";
    ViewBag.gblBlnView = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.View);
    ViewBag.gblBlnEdit = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Edit);
    ViewBag.gblBlnAdd = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Add);
    ViewBag.gblBlnDelete = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Delete);
    //bool IsEdit = true;
    if (!ViewBag.gblBlnView)
    {
        Response.Redirect(CFS.Com.ClsCommon.GetRootPath() + "Error/unauthorize/");
    }
    System.Text.StringBuilder StrAutocomplete = new System.Text.StringBuilder();
}

<style>
    .ui-autocomplete {
        z-index: 10000;
    }
</style>
<!-- Main content -->
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                    @if (Model != null && Model.doaction == "view")
                    {
                        <div class="pull-left">
                            <div style="display: inline-flex">
                                <span class="badge bg-light-blue" style="font-size:15px;">Excess Cargo Removal Ref No : @Model.ExcessCargoRemovalPrefix@Model.ExcessCargoRemovalNo</span>
                                <span class="badge bg-light-blue" style="font-size:15px;">Excess Cargo Removal Ref Date : @Model.CreatedDate</span>
                                <span class="badge bg-light-blue" style="font-size:15px;">User : @Model.UserName</span>
                            </div>
                        </div>
                    }
                    <div class="pull-right" id="divBack">
                        <div style="display: inline-flex">
                            <a id="btnBack" href="@Url.Action("Index",CFS.Com.ClsCommon.Controller(), new {pg = Request.Params["pg"], search = Request.Params["search"] })" class="btn btn-primary btn-sm" style="color: #fff" data-toggle="tooltip" title="Back to listing"><i class="fa fa-arrow-left"></i></a>
                        </div>
                    </div>
                </div>
                <div class="box-body">
                    @Html.HiddenFor(Model => Model.IsFinished)
                    @Html.HiddenFor(Model => Model.LoginUser)
                    @Html.HiddenFor(Model => Model.LoginUserID)
                    @if (Model.ExcessCargoRemovalID > 0)
                    {
                        @Html.HiddenFor(Model => Model.pagger.Search)
                        @Html.HiddenFor(Model => Model.doaction)
                        @Html.HiddenFor(Model => Model.IsSearch)
                        @Html.HiddenFor(Model => Model.ExcessCargoRemovalPrefix)
                        @Html.HiddenFor(Model => Model.ExcessCargoRemovalNo)


                        <div class="col-md-12">
                            <div class="box-body">
                                <div class="col-md-2">
                                    <div class="form-group">
                                        @Html.LabelFor(Model => Model.trnDocumentNo)<span class="text-red">*</span>
                                        @Html.TextBoxFor(Model => Model.trnDocumentNo, new { @id = "trnDocumentNo", @name = "trnDocumentNo", @class = "form-control", @placeholder = "SELECT trnDocumentNo", @readonly = "true" })
                                        @Html.HiddenFor(Model => Model.trnDocumentID, new { @id = "trnDocumentID", @name = "trnDocumentID" })
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        @Html.LabelFor(Model => Model.ReasonRemoval, new { @for = "ReasonRemoval" }) <span class="text-red"> *</span> @Html.ValidationMessageFor(Model => Model.ReasonRemoval, String.Empty, new { @id = "spn_WHVCategory", @class = "help-inline text-red" })
                                        @Html.DropDownListFor(Model => Model.ReasonRemoval, Model.ReasonRemovalList, new { @id = "ReasonRemoval", @name = "ReasonRemoval", @class = "form-control", @disabled = "disabled" })
                                    </div>
                                </div>

                                <div class="col-md-2">
                                    <div class="form-group">
                                        @Html.LabelFor(Model => Model.ApprovalMailDate, new { @for = "ApprovalMailDate" })<span class="text-red"> *</span>  @Html.ValidationMessageFor(Model => Model.ApprovalMailDate, String.Empty, new { @id = "spn_ApprovalMailDate", @class = "help-inline text-red" })
                                        @Html.TextBoxFor(Model => Model.ApprovalMailDate, new { @id = "ApprovalMailDate", @name = "ApprovalMailDate", @class = "form-control DatePicker", @placeholder = "Select Approval Mail Date", @readonly = "true" })
                                    </div>
                                </div>

                                <div class="col-md-2">
                                    <div class="form-group">
                                        @Html.LabelFor(Model => Model.ApprovedBy)<span class="text-red">*</span>@Html.ValidationMessageFor(Model => Model.ApprovedBy, String.Empty, new { @class = "help-inline text-red", @id = "spn_ApprovedBy" })
                                        @Html.TextBoxFor(Model => Model.ApprovedBy, new { @id = "ApprovedBy", @name = "ApprovedBy", @class = "form-control", @placeholder = "Select/Enter Approved By", @readonly = "true" })
                                        @Html.HiddenFor(Model => Model.ApprovedById, new { @id = "ApprovedById", @name = "ApprovedById" })
                                    </div>
                                </div>

                            </div>
                        </div>
                        if (Model.IsFinished)
                        {
                            <div class="col-md-12" id="IsApprovdone">
                                <div class="box-body">

                                    <div class="col-md-2">
                                        <div class="form-group">
                                            @Html.LabelFor(Model => Model.CheckedBy)
                                            @Html.CheckBoxFor(Model => Model.CheckedByCheck, new { @id = "CheckedByCheck", @class = "form-control", @disabled = "disabled" })
                                            @Html.TextBoxFor(Model => Model.CheckedBy, new { @id = "CheckedBy", @name = "CheckedBy", @class = "form-control", @placeholder = "Select/Enter Checked By", @readonly = "true" })
                                            @Html.HiddenFor(Model => Model.CheckedById, new { @id = "CheckedById", @name = "CheckedById" })
                                            @Html.HiddenFor(Model => Model.hdnCheckedByCheck, new { @id = "hdnCheckedByCheck", @name = "hdnCheckedByCheck" })
                                        </div>
                                    </div>

                                    <div class="col-md-2">
                                        <div class="form-group">
                                            @Html.LabelFor(Model => Model.CheckedByRemarks)
                                            @Html.TextBoxFor(Model => Model.CheckedByRemarks, new { @id = "CheckedByRemarks", @name = "CheckedByRemarks", @class = "form-control", @placeholder = "Enter Remarks", @readonly = "true" })
                                        </div>
                                    </div>
                                    <div id="IsCheckedone">
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                @Html.LabelFor(Model => Model.AcknowledgedBy)
                                                @Html.CheckBoxFor(Model => Model.AcknowledgedByCheck, new { @id = "AcknowledgedByCheck", @class = "form-control", @disabled = "disabled" })
                                                @Html.TextBoxFor(Model => Model.AcknowledgedBy, new { @id = "AcknowledgedBy", @name = "AcknowledgedBy", @class = "form-control", @placeholder = "Select/Enter Acknowledged By", @readonly = "true" })
                                                @Html.HiddenFor(Model => Model.AcknowledgedById, new { @id = "AcknowledgedById", @name = "AcknowledgedById" })
                                            </div>
                                        </div>

                                        <div class="col-md-2">
                                            <div class="form-group">
                                                @Html.LabelFor(Model => Model.AcknowledgedRemarks)
                                                @Html.TextBoxFor(Model => Model.AcknowledgedRemarks, new { @id = "AcknowledgedRemarks", @name = "AcknowledgedRemarks", @class = "form-control", @placeholder = "Enter Remarks", @readonly = "true" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }


                        <div class="col-md-12">
                            <div class="box-body">

                                <div class="col-md-2">
                                    <div class="form-group">
                                        @Html.LabelFor(Model => Model.CRUpdatedBy)<span class="text-red">*</span>@Html.ValidationMessageFor(Model => Model.CRUpdatedBy, String.Empty, new { @class = "help-inline text-red", @id = "spn_CRUpdatedBy" })
                                        @Html.TextBoxFor(Model => Model.CRUpdatedBy, new { @id = "CRUpdatedBy", @name = "CRUpdatedBy", @class = "form-control", @placeholder = "Select/Enter Updated By", @readonly = "true" })
                                        @Html.HiddenFor(Model => Model.CRUpdatedById, new { @id = "CRUpdatedById", @name = "CRUpdatedById" })
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        @Html.LabelFor(Model => Model.MainRemarks)
                                        @Html.TextBoxFor(Model => Model.Remarks, new { @id = "Remarks", @name = "Remarks", @class = "form-control", @placeholder = "Enter Remarks", @readonly = "true" })
                                    </div>
                                </div>
                            </div>
                        </div>

                    }
                </div>
            </div>
        </div>
    </div>
    @if (Model.doaction == "view" && CFS.Com.ClsCommon.DocDatatable.Rows.Count > 0)
    {
        <div class="row">

            <div class="box">
                <div class="box-header with-border">
                    <h4><b>Document Detail </b></h4>

                </div>
                <div class="box-body">

                    <div class="col-md-12" style="overflow:scroll;">
                        <table id="NOC-detail" style="width:100%; white-space:nowrap;" class="table table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th>BOE No.</th>
                                    <th>BOE Date</th>
                                    <th>CHA/BROKER</th>
                                    <th>IMPORTER/PARTY</th>
                                    <th>BULK/NB STATUS</th>
                                    <th>Cargo Desc</th>
                                    <th>PACKAGE TYPE</th>

                                    <th>Balance Packages</th>
                                    <th>Balance Pieces</th>
                                    <th>Balance Weight</th>

                                    <th>NO OF PKGS</th>
                                    <th>NO.OF PIECES</th>
                                    <th>WEIGHT (KGS)</th>

                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < CFS.Com.ClsCommon.DocDatatable.Rows.Count; i++)
                                {
                                    Model.hdnBALPKGS = new decimal[(CFS.Com.ClsCommon.DocDatatable.Rows.Count + (10 - (CFS.Com.ClsCommon.DocDatatable.Rows.Count % 10)))];
                                    Model.hdnBALPIECES = new decimal[(CFS.Com.ClsCommon.DocDatatable.Rows.Count + (10 - (CFS.Com.ClsCommon.DocDatatable.Rows.Count % 10)))];
                                    Model.hdnBALWEIGHT = new decimal[(CFS.Com.ClsCommon.DocDatatable.Rows.Count + (10 - (CFS.Com.ClsCommon.DocDatatable.Rows.Count % 10)))];
                                    Model.RemovalPKGS = new string[(CFS.Com.ClsCommon.DocDatatable.Rows.Count + (10 - (CFS.Com.ClsCommon.DocDatatable.Rows.Count % 10)))];
                                    Model.RemovalPIECES = new string[(CFS.Com.ClsCommon.DocDatatable.Rows.Count + (10 - (CFS.Com.ClsCommon.DocDatatable.Rows.Count % 10)))];
                                    Model.RemovalWEIGHT = new string[(CFS.Com.ClsCommon.DocDatatable.Rows.Count + (10 - (CFS.Com.ClsCommon.DocDatatable.Rows.Count % 10)))];
                                    Model.hdntrnDocumentLotDetailsID = new decimal[(CFS.Com.ClsCommon.DocDatatable.Rows.Count + (10 - (CFS.Com.ClsCommon.DocDatatable.Rows.Count % 10)))];
                                    Model.ExcessCargoRemovalDetailsID = new int[(CFS.Com.ClsCommon.DocDatatable.Rows.Count + (10 - (CFS.Com.ClsCommon.DocDatatable.Rows.Count % 10)))];

                                    Model.hdnBALPKGS[i] = Convert.ToDecimal(CFS.Com.ClsCommon.DocDatatable.Rows[i]["BALPKG"]);
                                    Model.hdnBALPIECES[i] = Convert.ToDecimal(CFS.Com.ClsCommon.DocDatatable.Rows[i]["BALPCS"]);
                                    Model.hdnBALWEIGHT[i] = Convert.ToDecimal(CFS.Com.ClsCommon.DocDatatable.Rows[i]["BALWGT"]);
                                    Model.hdntrnDocumentLotDetailsID[i] = Convert.ToInt32(CFS.Com.ClsCommon.DocDatatable.Rows[i]["trnDocumentLotDetailsID"]);
                                    Model.ExcessCargoRemovalDetailsID[i] = Convert.ToInt32(CFS.Com.ClsCommon.DocDatatable.Rows[i]["ExcessCargoRemovalDetailsID"]);
                                    Model.RemovalPKGS[i] = Convert.ToDecimal(CFS.Com.ClsCommon.DocDatatable.Rows[i]["RemovalPKGS"]).ToString("0.00");
                                    Model.RemovalPIECES[i] = Convert.ToDecimal(CFS.Com.ClsCommon.DocDatatable.Rows[i]["RemovalPIECES"]).ToString("0.00");
                                    Model.RemovalWEIGHT[i] = Convert.ToDecimal(CFS.Com.ClsCommon.DocDatatable.Rows[i]["RemovalWEIGHT"]).ToString("0.00");

                                    <tr>
                                        <td>@CFS.Com.ClsCommon.DocDatatable.Rows[i]["BOENo"]</td>
                                        @if (CFS.Com.ClsCommon.DocDatatable.Rows[i]["BOEDate"] != null && CFS.Com.ClsCommon.DocDatatable.Rows[i]["BOEDate"].ToString() != "")
                                        {
                                            <td>@(Convert.ToDateTime(CFS.Com.ClsCommon.DocDatatable.Rows[i]["BOEDate"]).ToString(CFS.Com.ClsCommon.CSProjectDateFormat))</td>
                                        }
                                        else
                                        {
                                            <td></td>
                                        }
                                        <td>@CFS.Com.ClsCommon.DocDatatable.Rows[i]["CHAName"]</td>
                                        <td>@CFS.Com.ClsCommon.DocDatatable.Rows[i]["ImporterName"]</td>
                                        <td>@CFS.Com.ClsCommon.DocDatatable.Rows[i]["BULKSTATUS"]</td>
                                        <td>@CFS.Com.ClsCommon.DocDatatable.Rows[i]["CARGODESC"]</td>
                                        <td>@CFS.Com.ClsCommon.DocDatatable.Rows[i]["PACKAGETYPE"]</td>
                                        <td style="display:none;">@Html.HiddenFor(Model => Model.hdnBALPKGS[i], new { @id = "hdnBALPKGS_" + i, @style = "width: 50px;background:#eee", @readonly = "true" }) </td>
                                        <td style="display:none;">@Html.HiddenFor(Model => Model.hdnBALPIECES[i], new { @id = "hdnBALPIECES_" + i, @style = "width: 50px;background:#eee", @readonly = "true" }) </td>
                                        <td style="display:none;">@Html.HiddenFor(Model => Model.hdnBALWEIGHT[i], new { @id = "hdnBALWEIGHT_" + i, @style = "width: 50px;background:#eee", @readonly = "true" }) </td>
                                        <td style="display:none;">@Html.HiddenFor(Model => Model.hdntrnDocumentLotDetailsID[i], new { @id = "hdntrnDocumentLotDetailsID_" + i, @style = "width: 50px;background:#eee", @readonly = "true" }) </td>
                                        <td style="display:none;">@Html.HiddenFor(Model => Model.ExcessCargoRemovalDetailsID[i], new { @id = "ExcessCargoRemovalDetailsID_" + i, @style = "width: 50px;background:#eee", @readonly = "true" }) </td>
                                        <td>@CFS.Com.ClsCommon.DocDatatable.Rows[i]["BALPKG"]</td>
                                        <td>@CFS.Com.ClsCommon.DocDatatable.Rows[i]["BALPCS"]</td>
                                        <td>@CFS.Com.ClsCommon.DocDatatable.Rows[i]["BALWGT"]</td>

                                        <td align="right">@Html.TextBoxFor(Model => Model.RemovalPKGS[i], new { @id = "RemovalPKGS_" + i, @style = "width: 50px;", @onkeypress = "return isNumberWithTwoDecimal(event,'RemovalPKGS" + i + "')", @onblur = "checkitems('RemovalPKGS','" + i + "')", @disabled = "disabled" })</td>
                                        <td align="right">@Html.TextBoxFor(Model => Model.RemovalPIECES[i], new { @id = "RemovalPIECES_" + i, @style = "width: 50px;", @onkeypress = "return isNumberWithTwoDecimal(event,'RemovalPIECES" + i + "')", @onblur = "checkitems('RemovalPIECES','" + i + "')", @disabled = "disabled" })</td>
                                        <td align="right">@Html.TextBoxFor(Model => Model.RemovalWEIGHT[i], new { @id = "RemovalWEIGHT_" + i, @style = "width: 50px;", @onkeypress = "return isNumberWithTwoDecimal(event,'RemovalWEIGHT" + i + "')", @onblur = "checkitems('RemovalWEIGHT','" + i + "')", @disabled = "disabled" })</td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>

    }

</section>
<script>
    var doaction = '@Model.doaction';
    var IsView = false;
</script>
<script src="@CFS.Com.ClsCommon.GetCacheVersion("FormJs/ExcessCargoRemoval.js")"></script>


@model CFS.Models.trnCargoRepacking
@{
    ViewBag.gblBlnView = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.View);
    ViewBag.gblBlnEdit = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Edit);
    ViewBag.gblBlnAdd = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Add);
    ViewBag.gblBlnDelete = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Delete);
    ViewBag.gblBlnApprove = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Approve);
    ViewBag.gblBlnUnapprove = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Unapprove);
    var IsEdit = false;
    if (Model.doaction == "edit")
    {
        IsEdit = true;
        ViewBag.Title = "Update Repacking Of Cargo";
        if (!ViewBag.gblBlnEdit && !ViewBag.gblBlnAdd)
        {
            Response.Redirect(CFS.Com.ClsCommon.GetRootPath() + "Error/unauthorize/");
        }
    }
    else
    {
        ViewBag.Title = "Add New Repacking Of Cargo";
        if (!ViewBag.gblBlnAdd)
        {
            Response.Redirect(CFS.Com.ClsCommon.GetRootPath() + "Error/unauthorize/");
        }
    }
    System.Text.StringBuilder StrAutocomplete = new System.Text.StringBuilder();
}

<!-- Main content -->
<style>
    table th, table td {
        padding: 10px;
    }

    .tdWidth {
        width: 200px;
    }
</style>
@using (Html.BeginForm("Action", CFS.Com.ClsCommon.Controller(), FormMethod.Post))
{
    @Html.HiddenFor(Model => Model.page)
    @Html.HiddenFor(Model => Model.trnCargoRepackingID)
    @Html.HiddenFor(Model => Model.doaction)
    @Html.HiddenFor(Model => Model.filter)
    @Html.HiddenFor(Model => Model.trnCargoRepackingPrefix)
    @Html.HiddenFor(Model => Model.trnCargoRepackingNo)
    @Html.HiddenFor(Model => Model.IsFinished)
    <section class="content">

        <div class="box row">
            <div class="box-body">

                @if (Model != null && Model.doaction == "edit")
                {
                    <div class="pull-left">
                        <div style="display: inline-flex">
                            <span class="badge bg-light-blue" style="font-size:15px;">Repacking Ref No : @CFS.Com.ClsCommon.AddhtmlSpace(3)@Model.trnCargoRepackingPrefix@Model.trnCargoRepackingNo</span>
                            <span class="badge bg-light-blue" style="font-size:15px;">Repacking Ref Date : @CFS.Com.ClsCommon.AddhtmlSpace(3)@Model.CreatedDate</span>
                            <span class="badge bg-light-blue" style="font-size:15px;"> Created By:  @Model.UserName</span>
                        </div>
                    </div>
                }
                @Html.HiddenFor(Model => Model.ItemCount, new { @id = "ItemCount", @name = "ItemCount" })
                <div class="pull-right" id="divBack">
                    <div style="display: inline-flex">
                        <a id="btnBack" href="@Url.Action("Index","trnCargoRepacking", new {pg = Request.Params["pg"], search = Request.Params["search"] })" class="btn btn-primary btn-sm" style="color: #fff" data-toggle="tooltip" title="Back to listing"><i class="fa fa-arrow-left"></i></a>
                    </div>
                </div>
                <div id="divHeaderDetail">
                    <div class="col-md-12">
                        <div class="box-body">
                            <div class="col-md-2">
                                <div class="form-group">
                                    @Html.LabelFor(Model => Model.NOCNo)<span class="text-red">*</span> @Html.ValidationMessageFor(Model => Model.NOCNo, String.Empty, new { @id = "spn_NOCNo", @class = "help-inline text-red" })
                                    @if (Model.IsSearch || Model.doaction == "edit")
                                    {
                                        @Html.TextBoxFor(Model => Model.NOCNo, new { @id = "NOCNo", @name = "NOCNo", @class = "form-control", @placeholder = "SELECT NOCNo", @readonly = "true" })
                                    }
                                    else
                                    {
                                        @Html.TextBoxFor(Model => Model.NOCNo, new { @id = "NOCNo", @name = "NOCNo", @class = "form-control", @placeholder = "SELECT NOCNo" })
                                    }
                                    @Html.HiddenFor(Model => Model.trnDocumentID, new { @id = "trnDocumentID", @name = "trnDocumentID" })
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    @Html.LabelFor(Model => Model.BOENo)<span class="text-red">*</span>@Html.ValidationMessageFor(Model => Model.BOENo, String.Empty, new { @class = "help-inline text-red", @id = "spn_BOENo" })
                                    @if (Model.IsSearch || Model.doaction == "edit")
                                    {
                                        @Html.TextBoxFor(Model => Model.BOENo, new { @id = "BOENo", @name = "BOENo", @class = "form-control", @placeholder = "Select Lot Number", @readonly = "true" })
                                    }
                                    else
                                    {
                                        @Html.TextBoxFor(Model => Model.BOENo, new { @id = "BOENo", @name = "BOENo", @class = "form-control", @placeholder = "Select BOE Number" })
                                    }

                                    @Html.HiddenFor(Model => Model.trnDocumentLotDetailsID, new { @id = "trnDocumentLotDetailsID", @name = "trnDocumentLotDetailsID" })
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    @Html.LabelFor(Model => Model.BookingAreaUom)
                                    @Html.TextBoxFor(Model => Model.BookingAreaUom, new { @id = "BookingAreaUom", @name = "BookingAreaUom", @class = "form-control", @readonly = true })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="box-body">
                            <div class="col-md-2">
                                <div class="form-group">
                                    @Html.LabelFor(Model => Model.AreaBooked)
                                    @Html.TextBoxFor(Model => Model.AreaBooked, new { @id = "AreaBooked", @name = "AreaBooked", @class = "form-control", @readonly = "true" })
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    @Html.LabelFor(Model => Model.AreaReceived)
                                    @Html.TextBoxFor(Model => Model.AreaReceived, new { @id = "AreaReceived", @name = "AreaReceived", @class = "form-control", @readonly = "true" })
                                </div>
                            </div>
                            <div class="col-md-2">
                                @Html.LabelFor(Model => Model.AreaReleased)
                                @Html.TextBoxFor(Model => Model.AreaReleased, new { @id = "AreaReleased", @name = "AreaReleased", @class = "form-control", @readonly = "true" })
                            </div>

                            <div class="col-md-2">
                                <div class="form-group">
                                    @Html.LabelFor(Model => Model.BalanceArea)
                                    @Html.TextBoxFor(Model => Model.BalanceArea, new { @id = "BalanceArea", @name = "BalanceArea", @class = "form-control", @readonly = "true" })
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    @Html.LabelFor(Model => Model.AreaDifference)<span class="text-red">*</span>@Html.ValidationMessageFor(Model => Model.AreaDifference, String.Empty, new { @class = "help-inline text-red", @id = "spn_AreaDifference" })
                                    @Html.TextBoxFor(Model => Model.AreaDifference, new { @id = "AreaDifference", @name = "AreaDifference", @class = "form-control", @onblur = "GetFinalNocBalanceArea()", @oninput = "return NumberWithTwoDecimalWithNegative(event,'AreaDifference')", @maxlength = "8" })
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    @Html.LabelFor(Model => Model.FinalBalanceArea)<span class="text-red">*</span> @Html.ValidationMessageFor(Model => Model.FinalBalanceArea, String.Empty, new { @id = "spn_FinalBalanceArea", @class = "help-inline text-red" })
                                    @Html.TextBoxFor(Model => Model.FinalBalanceArea, new { @id = "FinalBalanceArea", @name = "FinalBalanceArea", @class = "form-control", @readonly = "true" })
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    @Html.LabelFor(Model => Model.PackingType)<span class="text-red">*</span>@Html.ValidationMessageFor(Model => Model.PackingType, String.Empty, new { @class = "help-inline text-red", @id = "spn_PackingType" })
                                    @Html.TextBoxFor(Model => Model.PackingType, new { @id = "PackingType", @name = "PackingType", @class = "form-control", @placeholder = "Enter New Packing Type" })
                                    @Html.HiddenFor(Model => Model.PackingTypeID, new { @id = "PackingTypeID", @name = "PackingTypeID" })
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    @Html.LabelFor(Model => Model.WHLocation)<span class="text-red">*</span>@Html.ValidationMessageFor(Model => Model.WHLocation, String.Empty, new { @class = "help-inline text-red", @id = "spn_WHLocation" })
                                    @Html.TextBoxFor(Model => Model.WHLocation, new { @id = "WHLocation", @name = "WhLocation", @class = "form-control", @placeholder = "Enter New WH Location" })
                                    @Html.HiddenFor(Model => Model.WHLocationID, new { @id = "WHLocationID", @name = "WHLocationID" })
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    @Html.LabelFor(Model => Model.Remarks)
                                    @Html.TextBoxFor(Model => Model.Remarks, new { @id = "Remarks", @name = "Remarks", @class = "form-control", @placeholder = "Enter Remarks" })

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="box-body">
                            @if (Model.doaction == "add")
                            {
                                <div class="col-md-6 pull-right">
                                    <div class="form-group pull-right">
                                        <br />
                                        <button type="submit" style="margin-right: 5px;" class="btn btn-primary" id="btnHeaderSave" onclick="return ValidateForm()"> Continue </button>
                                        <a href="@Url.Action("index", "trnCargoRepacking")" style="margin-right: 5px;" class="btn btn-danger" id="btnHeaderClear">Cancel</a>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>



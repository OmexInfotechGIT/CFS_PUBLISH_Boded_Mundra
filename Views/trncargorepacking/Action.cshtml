                                                                                                                                    Autocompletebox('lsttrnCargoRepackingItems_" + i + @"__NewWHLocation', 'lsttrnCargoRepackingItems_" + i + @"__NewWHLocationID', 'trnCargoRepacking', 'GetWHLocation');");

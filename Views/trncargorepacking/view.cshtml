@model CFS.Models.trnCargoRepacking
@{
    ViewBag.Title = "View Repacking Of Cargo";
    ViewBag.gblBlnView = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.View);
    ViewBag.gblBlnEdit = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Edit);
    ViewBag.gblBlnAdd = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Add);
    ViewBag.gblBlnDelete = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Delete);
    ViewBag.gblBlnApprove = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Approve);
    ViewBag.gblBlnUnapprove = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Unapprove);
    //bool IsEdit = true;
    if (!ViewBag.gblBlnView )
    {
        Response.Redirect(CFS.Com.ClsCommon.GetRootPath() + "Error/unauthorize/");
    }
    
}

<style>
    table th, table td {
        padding: 10px;
    }

    .tdWidth {
        width: 200px;
    }
</style>
<!-- Main content -->
 
    @Html.HiddenFor(Model => Model.page)
    @Html.HiddenFor(Model => Model.trnCargoRepackingID)
    @Html.HiddenFor(Model => Model.doaction)
    @Html.HiddenFor(Model => Model.filter)
    <section class="content">

        <div class="box row">
            <div class="box-header with-border">
                <div class="pull-left">
                    <div style="display: inline-flex">
                        <span class="badge bg-light-blue" style="font-size:15px;">Repacking Ref No : @CFS.Com.ClsCommon.AddhtmlSpace(3)@Model.trnCargoRepackingPrefix@Model.trnCargoRepackingNo</span>
                        <span class="badge bg-light-blue" style="font-size:15px;">Repacking Ref Date : @CFS.Com.ClsCommon.AddhtmlSpace(3)@Model.CreatedDate</span>
                        <span class="badge bg-light-blue" style="font-size:15px;"> Created By: @Model.UserName</span>
                    </div>
                </div>
                <div class="pull-right" id="divBack">
                    <div style="display: inline-flex">
                        <a id="btnBack" href="@Url.Action("Index", "trnCargoRepacking", new {pg = Request.Params["pg"], search = Request.Params["search"] })" class="btn btn-primary btn-sm" style="color: #fff" data-toggle="tooltip" title="Back to listing"><i class="fa fa-arrow-left"></i></a>
                    </div>
                </div>
            </div>
            <div class="box-body">

                @Html.HiddenFor(Model => Model.trnDocumentID, new { @id = "trnDocumentID", @name = "trnDocumentID" })
                @Html.HiddenFor(Model => Model.NOCNo, new { @id = "NOCNo", @name = "NOCNo" })
                @Html.HiddenFor(Model => Model.trnDocumentLotDetailsID, new { @id = "trnDocumentLotDetailsID", @name = "trnDocumentLotDetailsID" })
                @Html.HiddenFor(Model => Model.BOENo, new { @id = "BOENo", @name = "BOENo" })
                @Html.HiddenFor(Model => Model.AreaBooked, new { @id = "AreaBooked", @name = "AreaBooked" })
                @Html.HiddenFor(Model => Model.AreaReceived, new { @id = "AreaReceived", @name = "AreaReceived" })
                @Html.HiddenFor(Model => Model.AreaReleased, new { @id = "AreaReleased", @name = "AreaReleased" })
                @Html.HiddenFor(Model => Model.BalanceArea, new { @id = "BalanceArea", @name = "BalanceArea" })
                @Html.HiddenFor(Model => Model.AreaDifference, new { @id = "AreaDifference", @name = "AreaDifference" })
                @Html.HiddenFor(Model => Model.FinalBalanceArea, new { @id = "FinalBalanceArea", @name = "FinalBalanceArea" })
                @Html.HiddenFor(Model => Model.BookingAreaUom, new { @id = "BookingAreaUom", @name = "BookingAreaUom" })
                @Html.HiddenFor(Model => Model.PackingType, new { @id = "PackingType", @name = "PackingType" })
                @Html.HiddenFor(Model => Model.PackingTypeID, new { @id = "PackingTypeID", @name = "PackingTypeID" })
                @Html.HiddenFor(Model => Model.WHLocation, new { @id = "WHLocation", @name = "WHLocation" })
                @Html.HiddenFor(Model => Model.WHLocationID, new { @id = "WHLocationID", @name = "WHLocationID" })
                @Html.HiddenFor(Model => Model.Remarks, new { @id = "Remarks", @name = "Remarks" })

                <div class="col-md-12">

                    <div class="col-md-2">
                        <div class="form-group">
                            @Html.LabelFor(Model => Model.NOCNo) : <span>  @Model.NOCNo       </span>

                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            @Html.LabelFor(Model => Model.BOENo) : <span>  @Model.BOENo       </span>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            @Html.LabelFor(Model => Model.BookingAreaUom) : <span>  @Model.BookingAreaUom       </span>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group">
                            @Html.LabelFor(Model => Model.AreaBooked) : <span>  @Model.AreaBooked       </span>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            @Html.LabelFor(Model => Model.AreaReceived) : <span>  @Model.AreaReceived       </span>
                        </div>
                    </div>
                    <div class="col-md-2">
                        @Html.LabelFor(Model => Model.AreaReleased) : <span>  @Model.AreaReleased       </span>
                    </div>

                </div>

                <div class="col-md-12">

                    <div class="col-md-2">
                        <div class="form-group">
                            @Html.LabelFor(Model => Model.BalanceArea) : <span>  @Model.BalanceArea       </span>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            @Html.LabelFor(Model => Model.AreaDifference) : <span>  @Model.AreaDifference       </span>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            @Html.LabelFor(Model => Model.FinalBalanceArea) : <span>  @Model.FinalBalanceArea       </span>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            @Html.LabelFor(Model => Model.PackingType) : <span>  @Model.PackingType    </span>

                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            @Html.LabelFor(Model => Model.WHLocation) : <span>  @Model.WHLocation</span>
                        </div>
                    </div>

                </div>

                <div class="col-md-12">

                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(Model => Model.Remarks) : <span>  @Model.Remarks  </span>
                        </div>
                    </div>

                </div>

                <div class="col-md-12">
                    <div class="box-footer">


                        @if (Model.doaction == "add")
                        {
                            <div class="col-md-6 pull-right">
                                <div class="form-group">
                                    <br />
                                    <a href="@Url.Action("index", "trnCargoRepacking")" style="margin-right: 5px;" class="btn btn-danger pull-right">Cancel</a>
                                    <button type="button" style="margin-right: 5px;" class="btn btn-primary pull-right" id="SaveDocument" onclick="return validateModel()"> Continue </button>
                                </div>
                            </div>
                        }

                    </div>
                </div>

            </div>
        </div>




        <div class="box row">
            <div class="box-header with-border">
                <h4><b>Document Detail </b></h4>

            </div>
            <div class="box-body">
                @if (Model.doaction == "edit" && Model.lsttrnCargoRepackingItems.Count > 0)
                {


                    <div class="col-md-12" style="overflow:auto">




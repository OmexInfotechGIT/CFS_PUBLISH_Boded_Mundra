                                    <th>WH Location</th>
                                    <th>Packing Type</th>
                                    <th>Dec. Pkgs.</th>
                                    <th>Dec. Pcs.</th>
                                    <th>Dec. Weight</th>
                                    <th>Rec. Pkgs.</th>
                                    <th>Rec. Pcs.</th>
                                    <th>Rec. Weight</th>
                                    <th>Out. Pkgs.</th>
                                    <th>Out. Pcs.</th>
                                    <th>Out. Weight</th>
                                    <th>SB CLP Pkgs.</th>
                                    <th>SB CLP Pcs</th>
                                    <th>SB CLP Weight</th>
                                    <th>Bal. Pkgs.</th>
                                    <th>Bal. Pcs.</th>
                                    <th>Bal. Weight</th>
                                    <th>Repacking Pkgs.</th>
                                    <th>Repacking Pcs.</th>
                                    <th>Repacking Weight</th>
                                    <th>Packing Type</th>
                                    <th>WH Location</th>
                                </tr>
                            </thead>
                            <tbody id="tblData1">

                                @for (var i = 0; i < @Model.lsttrnCargoRepackingItems.Count; i++)
                                {
                                    <tr>

                                        <td style="display:none">

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].trnCargoRepackingItemsID)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].trnCargoRepackingID)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].trnDocumentLotDetailsID)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].trnDocumentID)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].trnDocumentBoiItemsID)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].CargoName)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].NOCDate)
                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].TruckContNo)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].DestuffType)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].trnDestuffingID)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].trnDestuffingDate)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].WHLocation)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].WHLocationID)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].PackingType)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].PackingTypeID)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].DecPackages)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].DecPieces)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].DecWeight)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].RecPackages)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].RecPieces)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].RecWeight)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].OutPackages)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].OutPieces)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].OutWeight)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].CLPPackages)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].CLPPieces)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].CLPWeight)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].BalPackages)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].BalPieces)

                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].BalWeight)


                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].YearID)
                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].RepackingPackages)
                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].RepackingPieces)
                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].RepackingWeight)
                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].NewPackingType)
                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].NewPackingTypeID)
                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].WHLocation)
                                            @Html.HiddenFor(m => Model.lsttrnCargoRepackingItems[i].WHLocationID)

                                        </td>

                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].CargoName)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].SpaceCertificateNo)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].NOCDate)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].TruckContNo)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].trnDestuffingDate)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].WHLocation)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].PackingType)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].DecPackages)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].DecPieces)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].DecWeight)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].RecPackages)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].RecPieces)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].RecWeight)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].OutPackages)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].OutPieces)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].OutWeight)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].CLPPackages)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].CLPPieces)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].CLPWeight)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].BalPackages)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].BalPieces)</td>
                                        <td>   @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].BalWeight)</td>
                                        <td>
                                            @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].RepackingPackages)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].RepackingPieces)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].RepackingWeight)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].NewPackingType, new { @class = "tdWidth" })
                                        </td>
                                        <td>
                                            @Html.DisplayFor(m => Model.lsttrnCargoRepackingItems[i].NewWHLocation, new { @class = "tdWidth" })
                                        </td>

                                    </tr>
                                }

                            </tbody>
                        </table>

                    </div>
                }
            </div>



        </div>


    </section>

<script>
    var doaction = '@Model.doaction';
    var IsView = false;
</script>

<script src="@CFS.Com.ClsCommon.GetCacheVersion("FormJs/trncargorepacking.js")"></script>


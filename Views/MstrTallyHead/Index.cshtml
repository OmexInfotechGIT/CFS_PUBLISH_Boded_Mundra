@model CFS.Models.MstrTallyHead
@{
    ViewBag.Title = "Tally Head List";
    ViewBag.gblBlnView = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.View);
    ViewBag.gblBlnEdit = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Edit);
    ViewBag.gblBlnAdd = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Add);
    ViewBag.gblBlnDelete = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Delete);
    if (!ViewBag.gblBlnView)
    {
        Response.Redirect(CFS.Com.ClsCommon.GetRootPath() + "Error/unauthorize/");
    }
}
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header" id="divSearch">
                    <div class="pull-right">
                        <div style="display: inline-flex">
                            <div class="input-group input-group-sm">
                                <input id="txtSearch" Name="txtSearch" type="text" class="form-control" value="@Model.pagger.Search">
                                <span class="input-group-btn">
                                    <button type="button" onclick="SearchData()" class="btn btn-primary btn-flat" id="btnSearch">Go!</button>
                                </span>
                            </div>
                            <div>&nbsp;</div>
                            <div>
                                @if (ViewBag.gblBlnAdd)
                                {
                                    <a id="btnAdd" href="@Url.Action("Action", "MstrTallyHead", new {doaction = "add" })" class="btn btn-primary btn-sm" style="color: #fff" data-toggle="tooltip" title="Add New TallyHead"><i class="fa fa-plus"></i></a>
                                }
                            </div>
                        </div>
                    </div>
                    <br />
                </div>
                <div class="box-body">


                    <div style="overflow-x:scroll">
                        <table id="example2" style="white-space:nowrap" class="table table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th>
                                        <a class="text-black" href="@Url.Action("Index", "MstrTallyHead", new {  pg = Model.pagger.CurrentPage, search = Model.pagger.Search,SortColumn = "TallyCustomerCode", SortOrder = (Model.pagger.SortColumn.ToLower() == "tallycustomercode" && Model.pagger.SortOrder.ToLower() =="asc" ? "desc" : "asc")} )"><i title="Click to sorting" class="fa fa-sort-amount-@((Model.pagger.SortColumn.ToLower() == "tallycustomercode" && Model.pagger.SortOrder.ToLower() =="asc" ? "desc" : "asc").ToString().ToLower())"></i> Tally Customer Code </a>
                                    </th>
                                    <th>
                                        <a class="text-black" href="@Url.Action("Index", "MstrTallyHead", new {  pg = Model.pagger.CurrentPage, search = Model.pagger.Search,SortColumn = "TallyHeadName", SortOrder = (Model.pagger.SortColumn.ToLower() == "tallyheadname" && Model.pagger.SortOrder.ToLower() =="asc" ? "desc" : "asc")} )"><i title="Click to sorting" class="fa fa-sort-amount-@((Model.pagger.SortColumn.ToLower() == "tallyheadname" && Model.pagger.SortOrder.ToLower() =="asc" ? "desc" : "asc").ToString().ToLower())"></i> Tally Customer </a>
                                    </th>
                                    @*<th>
                                        <a class="text-black" href="@Url.Action("Index", "MstrTallyHead", new {  pg = Model.pagger.CurrentPage, search = Model.pagger.Search,SortColumn = "MstrTariffHeadName", SortOrder = (Model.pagger.SortColumn.ToLower() == "mstrtariffheadname" && Model.pagger.SortOrder.ToLower() =="asc" ? "desc" : "asc")} )"><i title="Click to sorting" class="fa fa-sort-amount-@((Model.pagger.SortColumn.ToLower() == "mstrtariffheadname" && Model.pagger.SortOrder.ToLower() =="asc" ? "desc" : "asc").ToString().ToLower())"></i> TariffHead </a>
                                    </th>*@
                                    @*<th>
                                        <a class="text-black" href="@Url.Action("Index", "MstrTallyHead", new {  pg = Model.pagger.CurrentPage, search = Model.pagger.Search,SortColumn = "SazWithTaxTallyRefNo", SortOrder = (Model.pagger.SortColumn.ToLower() == "sazwithtaxtallyrefno" && Model.pagger.SortOrder.ToLower() =="asc" ? "desc" : "asc")} )"><i title="Click to sorting" class="fa fa-sort-amount-@((Model.pagger.SortColumn.ToLower() == "sazwithtaxtallyrefno" && Model.pagger.SortOrder.ToLower() =="asc" ? "desc" : "asc").ToString().ToLower())"></i> Sez With Tax Ref.No </a>
                                    </th>                                    
                                    <th>
                                        <a class="text-black" href="@Url.Action("Index", "MstrTallyHead", new { pg = Model.pagger.CurrentPage, search = Model.pagger.Search, SortColumn = "isSazWithOutTaxTallyRefNoactive", SortOrder = (Model.pagger.SortColumn.ToLower() == "sazwithouttaxtallyrefno" && Model.pagger.SortOrder.ToLower() == "asc" ? "desc" : "asc") })"><i title="Click to sorting" class="fa fa-sort-amount-@((Model.pagger.SortColumn.ToLower() == "sazwithouttaxtallyrefno" && Model.pagger.SortOrder.ToLower() == "asc" ? "desc" : "asc").ToString().ToLower())"></i> Sez WithOut Tax Ref.No </a>
                                    </th>*@                                    
                                    <th class="freezeLastColumn">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.MyDatatable != null && Model.MyDatatable.Rows.Count > 0)
                                {
                                    for (int i = 0; i < Model.MyDatatable.Rows.Count; i++)
                                    {
                                        <tr>
                                            <td>@Model.MyDatatable.Rows[i]["TallyCustomerCode"]</td>
                                            <td>@Model.MyDatatable.Rows[i]["TallyHeadName"]</td>
                                            @*<td>@Model.MyDatatable.Rows[i]["MstrTariffHeadName"]</td>
                                            <td>@Model.MyDatatable.Rows[i]["SezWithTaxTallyRefNo"]</td>
                                            <td>@Model.MyDatatable.Rows[i]["SezWithOutTaxTallyRefNo"]</td>*@
                                            
                                            <td class="freezeLastColumnwithWhite">
                                                @if (ViewBag.gblBlnEdit)
                                                {
                                                    <a href="@Url.Action("Action", "MstrTallyHead", new {  id = Model.MyDatatable.Rows[i]["MstrTallyHeadID"],pg = Model.pagger.CurrentPage, search = Model.pagger.Search, doaction = "edit" } )"><i title="Click to Edit" style=" font-size: x-large; cursor: pointer; vertical-align: middle;" class="fa fa-edit"></i></a>
                                                }
                                                @if (ViewBag.gblBlnView)
                                                {
                                                    <a href="@Url.Action("view", "MstrTallyHead", new { id = Model.MyDatatable.Rows[i]["MstrTallyHeadID"],pg = Model.pagger.CurrentPage, search = Model.pagger.Search })"><i title="Click to view" style=" font-size: x-large; cursor: pointer; vertical-align: middle;" class="fa fa-eye"></i></a>
                                                }
                                                <a><i data-toggle="modal" data-target="#myModal" onclick="ShowHistory('MstrTallyHead','@Model.MyDatatable.Rows[i]["MstrTallyHeadID"]')" title="History" style=" font-size: x-large; cursor: pointer; vertical-align: middle;" class="fa fa-info"></i></a>
                                                @if (ViewBag.gblBlnDelete)
                                                {
                                                    <a href="@Url.Action("delete", "MstrTallyHead", new { id = Model.MyDatatable.Rows[i]["MstrTallyHeadID"],pg = Model.pagger.CurrentPage, search = Model.pagger.Search })" onclick="return confirm('Are you sure want to delete this record?');"><i title="Click to Delete" style="font-size: x-large; cursor: pointer; vertical-align: middle; color:red" class="fa fa-trash-o"></i></a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }

                            </tbody>

                        </table>
                    </div>
                    @Html.Partial("_pagination")
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    var doaction = '@Model.doaction';
</script>
<script src="@CFS.Com.ClsCommon.GetCacheVersion("FormJs/MstrTallyHead.js")"></script>


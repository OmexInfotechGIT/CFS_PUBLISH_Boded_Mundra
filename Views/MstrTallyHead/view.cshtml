@model CFS.Models.MstrTallyHead
@{
    ViewBag.Title = "View Tally Customer";
    ViewBag.gblBlnView = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.View);
    if (!ViewBag.gblBlnView)
    {
        Response.Redirect(CFS.Com.ClsCommon.GetRootPath() + "Error/unauthorize/");
    }
}
<section class="content">
    <div class="row">
        <div class="col-xs-12">
            <div class="box">
                <div class="box-header">
                    <div class="pull-left">
                        <div style="display: inline-flex">
                            <span class="badge bg-light-blue" style="font-size:15px;">Tally Customer Code  @CFS.Com.ClsCommon.AddhtmlSpace(3): @CFS.Com.ClsCommon.AddhtmlSpace(3) @Model.TallyCustomerCode</span>
                        </div>
                    </div>
                    <div class="pull-right">
                        <div style="display: inline-flex">                            
                            <a href="@Url.Action("Index","MstrTallyHead", new {pg = Request.Params["pg"], search = Request.Params["search"] })" class="btn btn-primary btn-sm" style="color: #fff" data-toggle="tooltip" title="Back to listing"><i class="fa fa-arrow-left"></i></a>
                        </div>
                    </div>
                    <br />
                </div>
                <div class="box-body">
                    <div class="col-md-6">

                        <div class="box-body">
                            <div class="form-group">
                                <label>Tally Customer Name : </label> <span>@Model.TallyHeadName</span>
                            </div>

                            <div class="form-group" style="display:none;">
                                <label>Tally Code : </label> <span>@Model.RegularTallyRefNo</span>
                            </div>
                            <div class="form-group" style="display:none;">
                                <label>TariffHead : </label> <span>@Model.MstrTariffHeadName</span>
                            </div>
                            <div class="form-group" style="display:none;">
                                <label>Sez With Tax Tally RefNo : </label> <span>@Model.SezWithTaxTallyRefNo</span>
                            </div>

                            <div class="form-group" style="display:none;">
                                <label>Sez WithOut Tax Tally RefNo : </label> <span>@Model.SezWithOutTaxTallyRefNo</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

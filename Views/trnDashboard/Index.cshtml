@model CFS.Models.IRNDashboard
@{
    ViewBag.Title = "IRN Dashboard";
    ViewBag.gblBlnView = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.View);

    ViewBag.gblBlnEdit = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Edit);

    ViewBag.gblBlnAdd = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Add);

    ViewBag.gblBlnDelete = CFS.Com.ClsCommon.getaccesspage(CFS.Com.ClsCommon.Controller(), CFS.Com.ClsCommon.AccessType.Delete);
    if (!ViewBag.gblBlnView)
    {
        Response.Redirect(CFS.Com.ClsCommon.GetRootPath() + "Error/unauthorize");
    }
}
<link href="~/Content/theme/bower_components/jvectormap/jquery-jvectormap.css" rel="stylesheet" />

<link href="~/Content/theme/dist/css/skins/_all-skins.min.css" rel="stylesheet" />

<link rel="stylesheet" href="@CFS.Com.ClsCommon.GetCacheVersion("Content/css/IRNDashboard.css")" />
<!-- Main content -->
<section class="content">
    <!-- Info boxes -->
    <div class="row">
        <div class="col-md-2">
            @Html.LabelFor(Model => Model.InvoiceType, new { @for = "InvoiceType" }) <span class="text-red">*</span> @Html.ValidationMessageFor(Model => Model.InvoiceType, String.Empty, new { @id = "spn_InvoiceType", @class = "help-inline text-red" })
            @Html.DropDownListFor(Model => Model.InvoiceType, Model.DDLInvoiceType, "SELECT", new { @id = "InvoiceType", @name = "InvoiceType", @class = "form-control" })
        </div>
        <div class="col-md-2 form-group">
            @Html.LabelFor(Model => Model.FromDate, new { @for = "FromDate" })<span class="text-red">*</span> @Html.ValidationMessageFor(Model => Model.FromDate, String.Empty, new { @id = "spn_FromDate", @class = "help-inline text-red" })
            @Html.TextBoxFor(Model => Model.FromDate, new { @id = "FromDate", @name = "FromDate", @class = "form-control DatePicker" })
        </div>
        <div class="col-md-2 form-group">
            @Html.LabelFor(Model => Model.ToDate, new { @for = "ToDate" })<span class="text-red">*</span> @Html.ValidationMessageFor(Model => Model.ToDate, String.Empty, new { @id = "spn_ToDate", @class = "help-inline text-red" })
            @Html.TextBoxFor(Model => Model.ToDate, new { @id = "ToDate", @name = "ToDate", @class = "form-control DatePicker" })
        </div>
        <div class="col-md-2 form-group">
            <br />
            <button type="button" id="btnSearch" class="btn btn-primary" onclick="SearchIRNData()">Serach</button>
            <a href="@Url.Action("Index","trnDashboard")" class="btn btn-danger">Clear</a>
        </div>
        <div class="col-md-4">
            <br />
            <span style="color:red;font-weight:bold">To ensure fast and accurate results, the date filter only supports a range of up to 1 month. Please choose a date range within 30 days.</span>
        </div>
    </div>
    <div class="row fontsize">
        @if (Model.InvoiceType == "all")
        {
            <div class="col-md-4" id="AllbondInvoice">
                <div class="box box-primary">
                    <div class="box-header">
                        <a style="color: #444" href="@Url.Action("Index","BondInvoice")" target="_blank"><h3 class="box-title box-title-font">Bond Invoice</h3></a>
                    </div>
                    <!-- /.box-header -->
                    <div class="box-body no-padding chart-container-table-AllInvoice" style="overflow:auto;">
                        <table class="table table-condensed" style="white-space: nowrap;">
                            <thead>
                                <tr>
                                    <th>SrNo.</th>
                                    <th>Bond Invoice No</th>
                                    <th>Bond Invoice Date</th>
                                    <th>Customer</th>
                                    <th>Amount</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.dtBondInvoiceDetails != null && Model.dtBondInvoiceDetails.Rows.Count > 0)
                                {
                                    for (int i = 0; i < Model.dtBondInvoiceDetails.Rows.Count; i++)
                                    {
                                        int Srno = i + 1;
                                        <tr>
                                            <td>@Srno</td>
                                            <td>@Model.dtBondInvoiceDetails.Rows[i]["InvoiceNo"]</td>
                                            <td>@Model.dtBondInvoiceDetails.Rows[i]["InvoiceDate"]</td>
                                            <td>@Model.dtBondInvoiceDetails.Rows[i]["BillToParty"]</td>
                                            <td>@Model.dtBondInvoiceDetails.Rows[i]["Amount"]</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(Model.dtBondInvoiceDetails.Rows[i]["ErrorMsg"].ToString()))
                                                {
                                                    <a style="color:red;" data-toggle="modal" data-target="#ErrorMsgModal" onclick='DisplayError(@Html.Raw(Json.Encode(@Model.dtBondInvoiceDetails.Rows[i]["ErrorMsg"])))'>
                                                        <i title="Click to Error" style=" font-size: large; cursor: pointer; vertical-align: middle;" class="fa fa-warning"></i>
                                                    </a>
                                                }
                                                @if (Model.IsFinanceOrAdmin)
                                                {
                                                    if (Model.dtBondInvoiceDetails.Rows[i]["SEZStatus"].ToString().ToLower() == "registered")
                                                    {
                                                        <a data-toggle="modal" data-target="#myModalConfirmationWithEinvoicedashboard" onclick="return ApproveInvoice('true', 'approve', '@Model.dtBondInvoiceDetails.Rows[i]["BondInvoiceID"]', '@Model.dtBondInvoiceDetails.Rows[i]["InvoiceNo"]', 'bond', '@Model.dtBondInvoiceDetails.Rows[i]["trnDocumentID"]')">
                                                            <i title="Click to Approve" style=" font-size: large; cursor: pointer; vertical-align: middle;" class="fa fa-thumbs-o-up"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a data-toggle="modal" data-target="#myModalConfirmationWithEinvoicedashboard" onclick="return ApproveInvoice('false','approve','@Model.dtBondInvoiceDetails.Rows[i]["BondInvoiceID"]','@Model.dtBondInvoiceDetails.Rows[i]["InvoiceNo"]','bond' ,'@Model.dtBondInvoiceDetails.Rows[i]["trnDocumentID"]' )">
                                                            <i title="Click to Approve" style=" font-size: large; cursor: pointer; vertical-align: middle;" class="fa fa-thumbs-o-up"></i>
                                                        </a>
                                                    }
                                                }

                                            </td>
                                        </tr>
                                        if (i == 9)
                                        {
                                            break;
                                        }
                                    }
                                }
                                else
                                {
                                    <tr><td>No matching records found</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- /.box-body -->
                </div>
            </div>
            <div class="col-md-4" id="AllExportInvoice">

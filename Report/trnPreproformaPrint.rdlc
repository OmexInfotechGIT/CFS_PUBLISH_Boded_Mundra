                      <CellContents>
                        <Textbox Name="Rate">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIf(Fields!UOM.Value = "KGS",(IIF(Fields!Rate.Value = 0, (Fields!Total.Value /(Fields!QTY.Value + Fields!Area.Value + Fields!Weight.Value) ),Fields!Rate.Value)*1000),IIF(Fields!Rate.Value = 0, (Fields!Total.Value /(Fields!QTY.Value + Fields!Area.Value + Fields!Weight.Value) ),Fields!Rate.Value))</Value>

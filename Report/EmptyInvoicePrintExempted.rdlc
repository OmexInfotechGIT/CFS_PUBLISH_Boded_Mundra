                    <TablixCell />
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>2.32978cm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox359">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>1)  It is presumed that all consignments being received at warehouse are adequately insured against all possible risk during transportation and storage and Seabird Marine Services (Gujarat) Pvt. Ltd. assumes no liability in this respect.	</Value>
                                  <Style>
                                    <FontFamily>tahoma</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>2) Any discrepancy in the Invoice has to be reported within 3 days					</Value>
                                  <Style>
                                    <FontFamily>tahoma</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>3) Delayed payment beyond due date would attract Interest @ 24% p.a.											</Value>
                                  <Style>
                                    <FontFamily>tahoma</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>4) Demand Draft / Cheque should be in favour of Seabird Marine Services Pvt Ltd.	</Value>
                                  <Style>
                                    <FontFamily>tahoma</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>5) All disputes are subject to Mundra Jurisdiction.</Value>
                                  <Style>
                                    <FontFamily>tahoma</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>6) E &amp; O E				</Value>
                                  <Style>
                                    <FontFamily>tahoma</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox359</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <TopBorder>
                              <Color>Black</Color>
                              <Style>Solid</Style>
                              <Width>0.25pt</Width>
                            </TopBorder>
                            <BottomBorder>
                              <Color>Black</Color>

          <Textbox Name="Textbox359">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Notes :</Value>
                    <Style>
                      <FontFamily>tahoma</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>1) It is presumed that all consignments being received at warehouse are adequately insured against all possible risk during transportation and storage and </Value>
                    <Style>
                      <FontFamily>tahoma</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!CompanyName.Value, "Company")</Value>
                    <Style>
                      <FontFamily>tahoma</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> assumes no liability in this respect.					</Value>
                    <Style>
                      <FontFamily>tahoma</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>2) Any discrepancy in the Invoice has to be reported with 3 days.				</Value>
                    <Style>
                      <FontFamily>tahoma</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>3) Delayed payment beyond due date would attract Interest @ 24% p.a.											</Value>
                    <Style>
                      <FontFamily>tahoma</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>4) Demand Draft / Cheque should be in favour of </Value>
                    <Style>
                      <FontFamily>tahoma</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!CompanyName.Value, "Company")</Value>
                    <Style>
                      <FontFamily>tahoma</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>5) All disputes are subject to </Value>
                    <Style>
                      <FontFamily>tahoma</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>=LCase(First(Fields!City.Value, "Company"))</Value>
                    <Style>
                      <FontFamily>tahoma</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> Jurisdiction. </Value>
                    <Style>
                      <FontFamily>tahoma</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>6) E &amp; O E</Value>
                    <Style>
                      <FontFamily>tahoma</FontFamily>
                      <FontSize>7pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Textbox359</rd:DefaultName>
